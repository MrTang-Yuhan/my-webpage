---
layout: base.njk
title: Home
description: 技术出版级阅读体验与在线编辑能力
---

<section class="hero">
  <p class="hero-kicker">Personal Knowledge Publishing</p>
  <h1 class="hero-title">Mr. Tang 的个人知识站</h1>
  <p class="hero-subtitle">体系结构——权衡的艺术，性能的诗歌</p>
</section>

<section class="post-list-section" data-sort-scope>
  <div class="post-list-toolbar">
    <h2 class="section-title">最新文章</h2>
    <div class="post-sort-control">
      <label for="post-sort">排序方式</label>
      <select id="post-sort" data-post-sort aria-controls="home-posts" disabled>
        <option value="updated">按更新时间排序</option>
        <option value="created" selected>按创建日期排序</option>
        <option value="name">按名称排序</option>
      </select>
    </div>
  </div>
  <ul class="post-list" id="home-posts" data-home-posts data-sort-list>
    {% set allPosts = [] %}
    {% for dir, posts in collections.postsByDir %}
      {% for post in posts %}
        {% set allPosts = allPosts.concat([post]) %}
      {% endfor %}
    {% endfor %}
    {% for post in allPosts | sortHomePosts %}
        <li class="post-list-item" data-created="{{ post.date | sortTimestamp }}" data-updated="{{ post.data.updated | sortTimestamp(post.date) }}">
          <h3 class="post-list-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <div class="post-list-meta">
          <span class="post-date-item">
            <span class="post-date-label">创建</span>
            <time datetime="{{ post.date | formatDate }}">{{ post.date | formatDate }}</time>
          </span>
          {% if post.data.updated %}
            <span class="post-divider">·</span>
            <span class="post-date-item">
              <span class="post-date-label">更新</span>
              <time datetime="{{ post.data.updated | formatDate }}">{{ post.data.updated | formatDate }}</time>
            </span>
          {% endif %}
          <span class="post-divider">·</span>
          <span>{{ post.content | readingTime }}</span>
        </div>
        {% if post.data.description %}
          <p class="post-list-excerpt">{{ post.data.description }}</p>
        {% else %}
          <p class="post-list-excerpt">{{ post.content | truncateRenderedHtml(180) | safe }}</p>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</section>
<script src="/js/post-sort.js" defer></script>
